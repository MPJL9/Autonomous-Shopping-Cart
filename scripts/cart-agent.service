[Unit]
Description=Autonomous Shopping Cart Pi Agent
After=network-online.target pigpiod.service
Wants=network-online.target

[Service]
Type=simple
User=veda
WorkingDirectory=/home/veda/Autonomous-Shopping-Cart-main
ExecStart=/bin/bash /home/veda/Autonomous-Shopping-Cart-main/scripts/pi_run_agent.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
